<script lang="ts">
	interface TemplateOption {
		id: number;
		name: string;
		type: string;
		content: string;
	}

	import { untrack } from "svelte";
	import { ico } from "@/icons";
	import SkSelect from "../SkSelect.svelte";
	import { getReportTypesForJob } from "../../constants/index";
	import { formatDate as fmtDate, formatTime as fmtTime } from "../../utils/datetime";
	import type { JobType } from "../../interfaces/IUser";

	interface Props {
		title: string;
		reportId: string;
		officer: string;
		type: string;
		created: number;
		lastUpdated: number;
		onTitleChange: (title: string) => void;
		onTypeChange: (type: string) => void;
		onInsertTemplate?: () => void;
		onSelectTemplate?: (template: TemplateOption) => void;
		availableTemplates?: TemplateOption[];
		showTemplateMenu?: boolean;
		jobType?: JobType;
	}

	let {
		title,
		reportId,
		officer,
		type,
		created,
		lastUpdated,
		onTitleChange,
		onTypeChange,
		onInsertTemplate,
		onSelectTemplate,
		availableTemplates = [],
		showTemplateMenu = false,
		jobType = 'leo',
	}: Props = $props();

	// Local state so parent re-renders don't reset inputs
	let localTitle = $state(title);
	let localType = $state(type);

	// Sync from parent only when the prop value actually differs from what we last sent
	$effect(() => { const t = title; untrack(() => { if (t !== localTitle) localTitle = t; }); });
	$effect(() => { const t = type; untrack(() => { if (t !== localType) localType = t; }); });

	function handleTitleInput() {
		onTitleChange(localTitle);
	}

	function handleTypeChange() {
		onTypeChange(localType);
	}

	let matchingTemplates = $derived(availableTemplates.filter((t) => t.type === localType));

	let reportTypes = $derived(getReportTypesForJob(jobType));

	// Keep a report's saved type selectable even if it isn't in this job's list
	let typeOptions = $derived(
		[...reportTypes, ...(localType && !reportTypes.includes(localType) ? [localType] : [])].map((t) => ({
			value: t,
			label: t,
			icon: "description",
		})),
	);

	function formatDate(timestamp: number): string {
		return fmtDate(timestamp);
	}

	function formatTime(timestamp: number): string {
		return fmtTime(timestamp);
	}
</script>

<div class="report-info">
	<div class="field-grid">
		<div class="field">
			<span class="field-label">Report Type</span>
			<SkSelect
				bind:value={localType}
				options={typeOptions}
				placeholder="Select type"
				onchange={handleTypeChange}
			/>
		</div>
		<div class="field">
			<span class="field-label">Title <span class="req">*</span></span>
			<div class="sk-field">
				<input
					type="text"
					placeholder="Report Title"
					bind:value={localTitle}
					oninput={handleTitleInput}
				/>
			</div>
		</div>
	</div>

	<div class="meta-row">
		{#if reportId}
			<span class="meta-chip"><span class="meta-key">ID</span> {reportId}</span>
		{/if}
		<span class="meta-chip">
			<span class="meta-key">Officer</span>
			{#if officer.startsWith('NO CALLSIGN')}
				<span class="officer-badge no-callsign">NO CALLSIGN</span>
				{officer.replace('NO CALLSIGN', '').trim()}
			{:else if officer.includes(' ')}
				<span class="officer-badge">{officer.split(' ')[0]}</span>
				{officer.split(' ').slice(1).join(' ')}
			{:else}
				{officer}
			{/if}
		</span>
		<span class="meta-chip"><span class="meta-key">Created</span> {formatDate(created)} {formatTime(created)}</span>
		{#if onInsertTemplate && matchingTemplates.length > 0}
			<div class="template-wrapper">
				<button class="sk-btn sk-sm" onclick={onInsertTemplate} type="button">
					<span class="material-icons">{@html ico("description")}</span>
					{matchingTemplates.length === 1 ? "Insert Template" : "Templates..."}
				</button>
				{#if showTemplateMenu && matchingTemplates.length > 1 && onSelectTemplate}
					<div class="template-dropdown">
						{#each matchingTemplates as tmpl (tmpl.id)}
							<button class="template-dropdown-item" onclick={() => onSelectTemplate(tmpl)} type="button">
								{tmpl.name}
							</button>
						{/each}
					</div>
				{/if}
			</div>
		{/if}
	</div>

	<span class="field-label content-label">Report Content <span class="req">*</span></span>
</div>

